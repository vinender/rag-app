# --- Database (local dev: use docker-compose) ---
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=rag_db

# --- Database (production: single connection string, e.g. Render/Supabase/Neon) ---
# When DATABASE_URL is set it overrides the discrete vars above and enables SSL.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# DATABASE_SSL=true

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here

# --- Server ---
PORT=3000
# Comma-separated allowed origins for the frontend. Leave unset to allow all (dev).
# CORS_ORIGIN=https://your-frontend.vercel.app
