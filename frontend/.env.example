# --- Serverless mode (default): Next.js API routes do the RAG ---
# Neon (or any) Postgres with pgvector. Get one free at https://neon.tech
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
OPENAI_API_KEY=sk-your-key-here

# --- Optional: use the standalone NestJS backend instead of /api routes ---
# Base URL of the backend, no trailing slash. Leave unset for serverless mode.
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
